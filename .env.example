# Puerto en el que escucha el servidor
PORT=3005

# Cadena de conexión a MongoDB (incluye el nombre de la base de datos antes del "?")
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.mongodb.net/huerto?retryWrites=true&w=majority

# Secreto para firmar los tokens JWT (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio

# Duración del token (ejemplos: 15m, 1h, 24h, 7d)
JWT_EXPIRES_IN=1h